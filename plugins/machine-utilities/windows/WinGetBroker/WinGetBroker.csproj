<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>MachineUtilities.WinGetBroker</AssemblyName>
    <TargetFrameworks>net8.0;net8.0-windows10.0.26100.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.26100.0'">
    <OutputType>Exe</OutputType>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Keep restore deterministic on non-Windows hosts; publish -r overrides this default. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.29</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
    <CsWinRtPackageVersion>2.3.1</CsWinRtPackageVersion>
    <ProviderPackageVersion>1.29.280</ProviderPackageVersion>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
    <CsWinRTIncludes>Microsoft.Management.Deployment</CsWinRTIncludes>
    <WindowsSdkPackageSha512>IjFc4STI6HVYd7hG2O8LxdMbRsjJb0pbt8oSOV+Mcl+hoIRkuHKfopq6FHYdY5o1tbFprFSZaXtXzOeXnDaFjg==</WindowsSdkPackageSha512>
    <CsWinRtPackageSha512>5LkAwRSxcbZpBiAdJjRE9w8q6Jh4voRckbtmbCpMW3jMDb0n2pwxlxANyXRcLEoMAxSTSCKcmjcX6waWrPAUuw==</CsWinRtPackageSha512>
    <ProviderPackageSha512>uWSgGMlZEWCkdZ6kxXSI50fqFXaj8LWhFnOiEg0uKhpcSoEh2HCwPXasAiT32aZ3ZF8KGyOSlTtOal/+soZ7jg==</ProviderPackageSha512>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.26100.0'">
    <!-- RuntimeFrameworkVersion is global; keep it from overriding the independently pinned Windows SDK pack. -->
    <FrameworkReference Update="Microsoft.Windows.SDK.NET.Ref"
          RuntimeFrameworkVersion="$(WindowsSdkPackageVersion)" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="[$(CsWinRtPackageVersion)]" />
    <PackageReference Include="Microsoft.WindowsPackageManager.InProcCom" Version="[$(ProviderPackageVersion)]">
      <NoWarn>NU1701</NoWarn>
      <GeneratePathProperty>true</GeneratePathProperty>
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.26100.0'">
    <CsWinRTInputs Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)/lib/Microsoft.Management.Deployment.winmd" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)/runtimes/$(RuntimeIdentifier)/native/Microsoft.Management.Deployment.InProc.dll"
          Link="Microsoft.Management.Deployment.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)/runtimes/$(RuntimeIdentifier)/native/Microsoft.Management.Deployment.InProc.dll.manifest"
          Link="Microsoft.Management.Deployment.dll.manifest"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)/runtimes/$(RuntimeIdentifier)/native/Microsoft.Management.Deployment.winmd"
          Link="Microsoft.Management.Deployment.winmd"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_WindowsPackageManager_InProcCom)/runtimes/$(RuntimeIdentifier)/native/WindowsPackageManager.dll"
          Link="WindowsPackageManager.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <Target Name="ValidatePinnedPackageArchiveHashes"
          AfterTargets="Restore"
          BeforeTargets="CoreCompile"
          Condition="'$(TargetFramework)' == 'net8.0-windows10.0.26100.0'">
    <ItemGroup>
      <_PinnedPackageArchive Include="$(NuGetPackageRoot)microsoft.windows.sdk.net.ref/$(WindowsSdkPackageVersion)/microsoft.windows.sdk.net.ref.$(WindowsSdkPackageVersion).nupkg">
        <ExpectedSha512>$(WindowsSdkPackageSha512)</ExpectedSha512>
        <PackageName>Microsoft.Windows.SDK.NET.Ref</PackageName>
      </_PinnedPackageArchive>
      <_PinnedPackageArchive Include="$(NuGetPackageRoot)microsoft.windows.cswinrt/$(CsWinRtPackageVersion)/microsoft.windows.cswinrt.$(CsWinRtPackageVersion).nupkg">
        <ExpectedSha512>$(CsWinRtPackageSha512)</ExpectedSha512>
        <PackageName>Microsoft.Windows.CsWinRT</PackageName>
      </_PinnedPackageArchive>
      <_PinnedPackageArchive Include="$(NuGetPackageRoot)microsoft.windowspackagemanager.inproccom/$(ProviderPackageVersion)/microsoft.windowspackagemanager.inproccom.$(ProviderPackageVersion).nupkg">
        <ExpectedSha512>$(ProviderPackageSha512)</ExpectedSha512>
        <PackageName>Microsoft.WindowsPackageManager.InProcCom</PackageName>
      </_PinnedPackageArchive>
    </ItemGroup>
    <Error Condition="!Exists('%(_PinnedPackageArchive.Identity)')"
           Text="Pinned %(_PinnedPackageArchive.PackageName) archive is unavailable." />
    <GetFileHash Files="@(_PinnedPackageArchive)" Algorithm="SHA512" HashEncoding="base64">
      <Output TaskParameter="Items" ItemName="_PinnedPackageArchiveWithHash" />
    </GetFileHash>
    <Error Condition="'%(_PinnedPackageArchiveWithHash.FileHash)' != '%(_PinnedPackageArchiveWithHash.ExpectedSha512)'"
           Text="Pinned %(_PinnedPackageArchiveWithHash.PackageName) archive hash drifted." />
  </Target>

</Project>
