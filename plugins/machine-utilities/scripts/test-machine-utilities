    {
      "id": "claude-settings",
      "path": "~/.claude/settings.json",
      "kind": "config",
      "format": "json",
      "settings": {
        "remoteControlAtStartup": true,
        "switchModelsOnFlag": false,
        "fallbackModel": null,
        "model": "fixture-model"
      },
      "agents": ["claude"],
      "groups": ["development"]
