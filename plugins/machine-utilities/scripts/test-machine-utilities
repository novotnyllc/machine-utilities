  source:"fixture",sourceUrl:"fixture",skillPath:"skills/danger",
  skillFolderHash:"danger-hash",installedAt:"2026-01-01",updatedAt:"2026-01-02"
}' "$tmp/home/.agents/.skill-lock.json" >"$tmp/option-skill-lock.json"
