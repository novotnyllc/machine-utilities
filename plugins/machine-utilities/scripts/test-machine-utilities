  "$tmp/windows-updates-worker-config.json")" = example ] ||
  fail "Windows worker config did not retain its Codex control project"
[ "$(jq -r '.projects | keys == ["example"]' \
  "$tmp/windows-updates-worker-config.json")" = true ] ||
  fail "Windows worker config did not retain only its required control project"
jq '.capabilities."example-research".requires_auth = ["missing-auth"]' \
  "$tmp/config.json" >"$tmp/invalid-capability-reference.json"
if MACHINE_UTILITIES_CONFIG="$tmp/invalid-capability-reference.json" \
  "$cli" validate-config >/dev/null 2>&1; then
  fail "capability accepted an unknown auth dependency"
fi
