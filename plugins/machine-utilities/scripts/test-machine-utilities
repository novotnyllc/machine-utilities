#!/usr/bin/env bash
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cli="$script_dir/machine-utilities"
plugin_version=$(jq -r '.version' "$script_dir/../.codex-plugin/plugin.json")
pwsh_command=$(command -v pwsh 2>/dev/null || true)
real_git=$(command -v git)
real_stat=$(command -v stat)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/machine-utilities-test.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/home/dev/example" "$tmp/bin"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  case $1 in
    *"$2"*) ;;
    *) fail "expected output to contain: $2" ;;
  esac
}

test_file_mode() {
  value=$(stat -f %Lp "$1" 2>/dev/null) ||
    value=$(stat -c %a "$1" 2>/dev/null) ||
    value=unknown
  printf '%s\n' "$value"
}

cat >"$tmp/config.json" <<'JSON'
