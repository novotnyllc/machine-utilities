metadata_snapshot() {
  destination=$1
  "${clean_env[@]}" "$apt_cache_path" policy >"$destination" 2>/dev/null || return 1
  [ "$(file_size "$destination")" -le 1048576 ] || return 1
  sha256_file "$destination"
}

installed_version() {
  inspected_package=$1
  installed_output=$("${clean_env[@]}" "$dpkg_query_path" -W \
    '-f=${db:Status-Abbrev}|${Version}\n' "$inspected_package" 2>/dev/null) || {
      printf '%s\n' -
      return 0
    }
  installed_status=${installed_output%%|*}
  installed_value=${installed_output#*|}
  [ "$installed_status" = 'ii ' ] && [[ $installed_value =~ ^[0-9A-Za-z][0-9A-Za-z.+:~_-]{0,127}$ ]] || return 1
  printf '%s\n' "$installed_value"
}

installed_state_snapshot() {
  destination=$1
  "${clean_env[@]}" "$dpkg_query_path" -W \
    '-f=${binary:Package}|${Version}|${db:Status-Abbrev}\n' 2>/dev/null |
    /usr/bin/sort >"$destination" || return 1
  sha256_file "$destination"
}

candidate_snapshot() {
  inspected_package=$1
  candidate_file=$policy_group_tmp/candidate
  "${clean_env[@]}" "$apt_cache_path" policy "$inspected_package" >"$candidate_file" 2>/dev/null || return 1
  candidate_version=$(/usr/bin/awk '/^[[:space:]]*Candidate:[[:space:]]/ {print $2;exit}' "$candidate_file")
  [[ $candidate_version =~ ^[0-9A-Za-z][0-9A-Za-z.+:~_-]{0,127}$ ]] || return 1
  candidate_source_line=$(/usr/bin/awk -v version="$candidate_version" '
    ($1==version)||($1=="***"&&$2==version) { selected=1; next }
    selected && $1~/^[0-9]+$/ { $1=$1; print; exit }
  ' "$candidate_file")
  [ -n "$candidate_source_line" ] || return 1
  candidate_source_digest=$(printf '%s\n' "$candidate_source_line" | sha256_stream)
}

source_identity_matches() {
  /usr/bin/awk -F '|' -v source="$1" -v expected="$2" '
    $1=="source"&&$2==source { if ($3==expected) found++; else exit 1 }
    END { if (found!=1) exit 1 }
  ' "$source_identities"
}

closure_snapshot() {
  destination=$1
  shift
  raw_closure=$policy_group_tmp/closure.raw
  "${clean_env[@]}" "$apt_get_path" --quiet=2 --simulate "$@" >"$raw_closure" 2>/dev/null || return 1
  /usr/bin/awk '/^(Inst|Conf|Remv)[[:space:]]/ {print}' "$raw_closure" >"$destination" || return 1
  [ -s "$destination" ] && ! /usr/bin/grep -Eq '^Remv[[:space:]]' "$destination" || return 1
  sha256_file "$destination"
}

compute_preflight() {
  case $action_id in
    apt.update-metadata.v1)
      metadata_digest=$(metadata_snapshot "$policy_group_tmp/metadata") || return 1
      fresh_precondition_digest=$(printf 'metadata|%s\n' "$metadata_digest" | sha256_stream)
      ;;
    apt.autoremove.v1)
      "${clean_env[@]}" "$apt_get_path" --quiet=2 --simulate autoremove \
        >"$policy_group_tmp/autoremove.pre" 2>/dev/null || return 1
      autoremove_pre_digest=$(sha256_file "$policy_group_tmp/autoremove.pre") || return 1
      pre_state_digest=$(installed_state_snapshot "$policy_group_tmp/installed.pre") || return 1
      fresh_precondition_digest=$(printf 'autoremove|%s|%s\n' \
        "$autoremove_pre_digest" "$pre_state_digest" | sha256_stream)
      ;;
    apt.install-package-version.v1)
      installed_before=$(installed_version "$package_id") || return 1
      [ "$installed_before" = - ] || return 1
      candidate_snapshot "$package_id" || return 1
      [ "$candidate_version" = "$exact_version" ] &&
        source_identity_matches "$source_id" "$candidate_source_digest" || return 1
      artifact_path=$generation/apt/artifacts/$policy_token.deb
      protected_file "$artifact_path" 33554432 &&
        [ "$(sha256_file "$artifact_path")" = "$artifact_digest" ] || return 1
      artifact_fields=$("${clean_env[@]}" "$dpkg_deb_path" --field "$artifact_path" \
        Package Version Architecture 2>/dev/null) || return 1
      [ "$artifact_fields" = "Package: $package_id
Version: $exact_version
Architecture: $apt_architecture" ] || return 1
      observed_closure=$(closure_snapshot "$policy_group_tmp/closure" --no-remove \
        --no-install-recommends install "$artifact_path") || return 1
      [ "$observed_closure" = "$closure_digest" ] || return 1
      derived_argv="/usr/bin/apt-get --quiet=2 --yes --no-remove --no-install-recommends install $artifact_path"
      fresh_precondition_digest=$(printf 'install|%s|absent|%s|%s|%s|%s\n' "$package_id" \
        "$exact_version" "$source_id" "$artifact_digest" "$observed_closure" | sha256_stream)
      ;;
    apt.upgrade-package.v1)
      installed_before=$(installed_version "$package_id") || return 1
      [ "$installed_before" != - ] || return 1
      candidate_snapshot "$package_id" || return 1
      "${clean_env[@]}" "$dpkg_path" --compare-versions "$installed_before" lt "$candidate_version" &&
        "${clean_env[@]}" "$dpkg_path" --compare-versions "$candidate_version" ge "$minimum_version" &&
        "${clean_env[@]}" "$dpkg_path" --compare-versions "$candidate_version" le "$maximum_version" || return 1
      candidate_without_epoch=${candidate_version#*:}
      candidate_major=${candidate_without_epoch%%.*}
      uint "$candidate_major" && [ "$candidate_major" -le "$major_ceiling" ] || return 1
      source_identity_matches "$source_id" "$candidate_source_digest" || return 1
      observed_closure=$(closure_snapshot "$policy_group_tmp/closure" --no-remove --only-upgrade \
        install "$package_id=$candidate_version") || return 1
      [ "$observed_closure" = "$closure_digest" ] || return 1
      exact_version=$candidate_version
      derived_argv="/usr/bin/apt-get --quiet=2 --yes --no-remove --only-upgrade install $package_id=$exact_version"
      fresh_precondition_digest=$(printf 'upgrade|%s|%s|%s|%s|%s|%s\n' "$package_id" \
        "$installed_before" "$candidate_version" "$source_id" "$major_ceiling" "$observed_closure" | sha256_stream)
      ;;
  esac
}

# Fresh policy, package, source, artifact, closure, and version checks all
# precede admission. They are repeated from protected state after the claim and
# immediately before the native launch.
compute_preflight || reject apt_precondition_unavailable
[ "$fresh_precondition_digest" = "$requested_precondition_digest" ] || reject precondition_drift
sealed_precondition_digest=$fresh_precondition_digest

durable_sync() {
  /bin/sync -f "$1" 2>/dev/null || /bin/sync
}

render_journal() {
  destination=$1
  journal_state=$2
  journal_reason=$3
  {
    printf 'result|1\nbroker-protocol|%s\nstate|%s\nreason|%s\nrequest-id|%s\nplan-id|%s\n' \
      "$broker_protocol" "$journal_state" "$journal_reason" "$request_id" "$plan_id"
    printf 'action-id|%s\noriginating-node-id|%s\nnode-key-fingerprint|%s\n' \
      "$action_id" "$node_id" "$requested_node_fingerprint"
    printf 'certificate-serial|%s\nfleet-ca-fingerprint|%s\nca-generation|%s\n' \
      "$requested_certificate_serial" "$requested_ca_fingerprint" "$requested_ca_generation"
    printf 'transport|%s\nrequest-principal|%s\nrequired-context|%s\n' \
      "$transport" "$request_principal" "$required_context"
    printf 'observed-execution-principal|root\nconsole-session-state|none\nplatform-boundary|linux\n'
    printf 'enrollment-epoch|%s\npolicy-sha256|%s\nconstraints-sha256|%s\n' \
      "$active_epoch" "$actual_policy_digest" "$actual_constraints_digest"
    printf 'context-canary-sha256|%s\nbroker-sha256|%s\nprecondition-sha256|%s\n' \
      "$actual_context_digest" "$actual_broker_digest" "$requested_precondition_digest"
    printf 'manager-source-identity|%s\nderived-argv|%s\n' "$requested_manager_identity" "$derived_argv"
    printf 'constraint-kind|%s\npackage-id|%s\nsource-id|%s\nexact-version|%s\n' \
      "$constraint_kind" "$package_id" "$source_id" "$exact_version"
    printf 'minimum-version|%s\nmaximum-version|%s\nmajor-ceiling|%s\n' \
      "$minimum_version" "$maximum_version" "$major_ceiling"
    printf 'artifact-sha256|%s\nclosure-sha256|%s\nmetadata-sha256|%s\n' \
      "$artifact_digest" "$closure_digest" "$metadata_digest"
    printf 'pre-state-sha256|%s\npost-state-sha256|%s\nautoremove-pre-sha256|%s\n' \
      "$pre_state_digest" "$post_state_digest" "$autoremove_pre_digest"
    printf 'autoremove-post-sha256|%s\n' "$autoremove_post_digest"
  } >"$destination"
}

compact_claims() {
  capacity_limit=$((max_claims - reserved_claim_slots))
  claim_count=0
  for existing_claim in "$replay_root"/request-*; do
    [ -e "$existing_claim" ] || continue
    [[ ${existing_claim##*/} =~ ^request-[0-9a-f]{32}$ ]] && protected_directory "$existing_claim" ||
      reject replay_state_drift
    claim_count=$((claim_count + 1))
  done
  [ "$claim_count" -lt "$capacity_limit" ] && return 0
  for existing_claim in "$replay_root"/request-*; do
    [ "$claim_count" -lt "$capacity_limit" ] && break
    [ -d "$existing_claim" ] || continue
    existing_tombstone=$existing_claim/tombstone
    existing_journal=$existing_claim/journal
    protected_file "$existing_tombstone" 2048 && protected_file "$existing_journal" 65536 ||
      reject replay_state_drift
    IFS='|' read -r tombstone_kind tombstone_version tombstone_request tombstone_until \
      tombstone_epoch tombstone_state <"$existing_tombstone" || reject replay_state_drift
    [ "$tombstone_kind" = tombstone ] && [ "$tombstone_version" = 1 ] &&
      [ "$tombstone_request" = "${existing_claim##*/}" ] && uint "$tombstone_until" &&
      uint "$tombstone_epoch" && [[ $tombstone_state =~ ^(completed|partial|rejected|stale)$ ]] ||
      continue
    [ "$tombstone_until" -le "$now" ] || continue
    compacted=$replay_root/.compacting-${existing_claim##*/}-$$
    [ ! -e "$compacted" ] && /bin/mv "$existing_claim" "$compacted" || reject replay_compaction_failed 74
    /bin/rm -f "$journal_root/${existing_claim##*/}.result" || reject replay_compaction_failed 74
    /bin/rm -rf "$compacted" || reject replay_compaction_failed 74
    claim_count=$((claim_count - 1))
  done
  [ "$claim_count" -lt "$capacity_limit" ] || reject claim_capacity_exhausted 75
}

retain_until=$((expires_at + max_clock_skew))
journal=$journal_root/$request_id.result
create_claim() {
  [ ! -e "$replay_root/$request_id" ] || reject replayed_request
  compact_claims
  claim_stage=$replay_root/.claim-$request_id-$$
  [ ! -e "$claim_stage" ] || reject claim_staging_collision 74
  /bin/mkdir "$claim_stage" || reject claim_reservation_failed 74
  /bin/chmod 0700 "$claim_stage" || reject claim_reservation_failed 74
  /bin/cp "$request_tmp" "$claim_stage/request" &&
    /bin/cp "$certificate_tmp" "$claim_stage/certificate" &&
    /bin/cp "$signature_tmp" "$claim_stage/signature" || reject claim_reservation_failed 74
  [ "$(sha256_file "$claim_stage/request")" = "$(sha256_file "$request_tmp")" ] ||
    reject claim_copy_mismatch 74
  printf 'tombstone|1|%s|%s|%s|validating\n' "$request_id" "$retain_until" "$active_epoch" \
    >"$claim_stage/tombstone" || reject claim_reservation_failed 74
  printf 'audit-reservation|1|%s|%s|%s|%s\n' "$request_id" "$plan_id" "$action_id" "$node_id" \
    >"$claim_stage/audit.reservation" || reject claim_reservation_failed 74
  render_journal "$claim_stage/journal" validating claim_reserved || reject claim_reservation_failed 74
  /bin/chmod 0600 "$claim_stage/request" "$claim_stage/certificate" "$claim_stage/signature" \
    "$claim_stage/tombstone" "$claim_stage/audit.reservation" "$claim_stage/journal" ||
    reject claim_reservation_failed 74
  durable_sync "$claim_stage/journal"
  durable_sync "$claim_stage"
  [ ! -e "$replay_root/$request_id" ] || reject replayed_request
  /bin/mv "$claim_stage" "$replay_root/$request_id" || reject claim_reservation_failed 74
  durable_sync "$replay_root"
  claim_directory=$replay_root/$request_id
  protected_directory "$claim_directory" && protected_file "$claim_directory/tombstone" 2048 &&
    protected_file "$claim_directory/journal" 65536 || reject claim_reservation_failed 74
}

update_tombstone() {
  tombstone_state=$1
  tombstone_tmp=$claim_directory/.tombstone.$$
  printf 'tombstone|1|%s|%s|%s|%s\n' "$request_id" "$retain_until" "$active_epoch" \
    "$tombstone_state" >"$tombstone_tmp" && /bin/chmod 0600 "$tombstone_tmp" &&
    durable_sync "$tombstone_tmp" && /bin/mv -f "$tombstone_tmp" "$claim_directory/tombstone" &&
    durable_sync "$claim_directory"
}

write_journal() {
  journal_state=$1
  journal_reason=$2
  canonical_tmp=$claim_directory/.journal.$$
  result_tmp=$journal_root/.$request_id.$$
  render_journal "$canonical_tmp" "$journal_state" "$journal_reason" &&
    /bin/chmod 0600 "$canonical_tmp" && durable_sync "$canonical_tmp" &&
    /bin/mv -f "$canonical_tmp" "$claim_directory/journal" && durable_sync "$claim_directory" || return 1
  /bin/cp "$claim_directory/journal" "$result_tmp" && /bin/chmod 0600 "$result_tmp" &&
    [ "$(sha256_file "$result_tmp")" = "$(sha256_file "$claim_directory/journal")" ] &&
    durable_sync "$result_tmp" && /bin/mv -f "$result_tmp" "$journal" && durable_sync "$journal_root" || return 1
  case $journal_state in completed|partial|rejected|stale) update_tombstone "$journal_state" || return 1 ;; esac
}

readonly public_root=$root_prefix/var/lib/machine-utilities-public
ensure_public_root() {
  if [ ! -e "$public_root" ]; then
    /bin/mkdir "$public_root" && /bin/chmod 0755 "$public_root" || return 1
  fi
  protected_directory "$public_root"
}
publish_public() {
  public_state=$1
  public_reason=$2
  public_kind=$3
  ensure_public_root || return 1
  public_tmp=$public_root/.$public_kind.$$
  {
    printf 'broker-public|1\nstate|%s\nreason|%s\nrequest-id|%s\nplan-id|%s\n' \
      "$public_state" "$public_reason" "$request_id" "$plan_id"
    printf 'action-id|%s\nenrollment-epoch|%s\n' "$action_id" "$active_epoch"
  } >"$public_tmp" && /bin/chmod 0644 "$public_tmp" && durable_sync "$public_tmp" &&
    /bin/mv -f "$public_tmp" "$public_root/$public_kind" && durable_sync "$public_root"
}

claim_failure() {
  failure_reason=$1
  failure_code=${2:-65}
  native_started=false
  write_journal rejected "$failure_reason" || true
  publish_public rejected "$failure_reason" last || true
  /bin/rm -f "$public_root/active" 2>/dev/null || true
  release_admission || true
  if [ -f "$claim_directory/journal" ]; then /bin/cat "$claim_directory/journal"
  else result rejected "$failure_reason"
  fi
  exit "$failure_code"
}

update_admission() {
  admission_state=$1
  admission_native_pid=${2:--}
  admission_native_pgid=${3:--}
  admission_native_start=${4:--}
  admission_tmp=$lock_root/active/.admission.$$
  printf 'admission|1|%s|%s|%s|%s|%s|%s|%s|%s\n' "$request_id" "$$" "$broker_start" \
    "$admission_native_pid" "$admission_native_pgid" "$admission_native_start" \
    "$admission_boot" "$admission_state" >"$admission_tmp" && /bin/chmod 0600 "$admission_tmp" &&
    durable_sync "$admission_tmp" && /bin/mv -f "$admission_tmp" "$lock_root/active/admission" &&
    durable_sync "$lock_root/active"
}

# Authentication and all static/fresh preflight gates are complete. Admission
# closes the enrollment drain race, and the following directory rename is the
# unified replay, journal, and audit reservation.
acquire_admission
create_claim
update_admission claimed || claim_failure admission_record_failed 74
write_journal validating audit_pending || claim_failure journal_write_failed 74
publish_public validating claim_reserved active || claim_failure public_record_write_failed 74

audit_log=$audit_root/events.log
if [ ! -e "$audit_log" ]; then
  audit_stage=$audit_root/.events.$$
  : >"$audit_stage" && /bin/chmod 0600 "$audit_stage" && /bin/mv "$audit_stage" "$audit_log" ||
    claim_failure audit_write_failed 74
fi
protected_file "$audit_log" 10485760 || claim_failure audit_write_failed 74
printf 'audit|1|%s|%s|%s|%s|%s|%s\n' "$now" "$request_id" "$plan_id" "$action_id" \
  "$node_id" "$(sha256_file "$claim_directory/request")" >>"$audit_log" ||
  claim_failure audit_write_failed 74
durable_sync "$audit_log"

compute_preflight || claim_failure apt_precondition_changed
[ "$fresh_precondition_digest" = "$sealed_precondition_digest" ] &&
  [ "$fresh_precondition_digest" = "$requested_precondition_digest" ] ||
  claim_failure precondition_changed_after_claim

write_journal executing native_launch_committed || claim_failure journal_write_failed 74
publish_public executing native_launch_committed active || claim_failure public_record_write_failed 74

native_arguments=(--quiet=2)
case $action_id in
  apt.update-metadata.v1) native_arguments+=(update) ;;
  apt.autoremove.v1) native_arguments+=(--yes autoremove) ;;
  apt.install-package-version.v1)
    native_arguments+=(--yes --no-remove --no-install-recommends install "$artifact_path")
    ;;
  apt.upgrade-package.v1)
    native_arguments+=(--yes --no-remove --only-upgrade install "$package_id=$exact_version")
    ;;
esac

native_rc=0
if [ "$fixture_mode" = true ]; then
  "${clean_env[@]}" "$apt_get_path" "${native_arguments[@]}" &
else
  "${clean_env[@]}" "$setsid_path" --wait "$apt_get_path" "${native_arguments[@]}" &
fi
native_pid=$!
native_pgid=$native_pid
native_started=true
native_start=$(process_start_identity "$native_pid" 2>/dev/null || true)
if ! digest "$native_start"; then native_start=-; fi
update_admission executing "$native_pid" "$native_pgid" "$native_start" || true
set +e
wait "$native_pid"
native_rc=$?
set -e
while group_live "$native_pgid"; do /bin/sleep 1; done
native_started=false
update_admission verifying "$native_pid" "$native_pgid" "$native_start" ||
  claim_failure admission_record_failed 74
write_journal verifying native_operation_exited || claim_failure journal_write_failed 74
publish_public verifying native_operation_exited active || claim_failure public_record_write_failed 74

if [ "$native_rc" -ne 0 ]; then
  write_journal partial native_operation_failed || true
  publish_public partial native_operation_failed last || true
  /bin/rm -f "$public_root/active" 2>/dev/null || true
  release_admission || true
  /bin/cat "$claim_directory/journal"
  exit 70
fi

post_reason=post_state_verified
case $action_id in
  apt.update-metadata.v1)
    metadata_digest=$(metadata_snapshot "$policy_group_tmp/metadata.post") || post_reason=metadata_post_state_unavailable
    post_state_digest=$metadata_digest
    ;;
  apt.autoremove.v1)
    "${clean_env[@]}" "$apt_get_path" --quiet=2 --simulate autoremove \
      >"$policy_group_tmp/autoremove.post" 2>/dev/null || post_reason=autoremove_post_state_unavailable
    if [ "$post_reason" = post_state_verified ]; then
      autoremove_post_digest=$(sha256_file "$policy_group_tmp/autoremove.post")
      if /usr/bin/grep -Eq '^(Inst|Remv)[[:space:]]' "$policy_group_tmp/autoremove.post"; then
        post_reason=autoremove_post_state_mismatch
      else
        post_state_digest=$(installed_state_snapshot "$policy_group_tmp/installed.post") ||
          post_reason=autoremove_post_state_unavailable
      fi
    fi
    ;;
  apt.install-package-version.v1|apt.upgrade-package.v1)
    installed_after=$(installed_version "$package_id") || post_reason=package_post_state_unavailable
    [ "$post_reason" != post_state_verified ] || [ "$installed_after" = "$exact_version" ] ||
      post_reason=package_post_state_mismatch
    if [ "$post_reason" = post_state_verified ]; then
      post_state_digest=$(printf 'package|%s|%s\n' "$package_id" "$installed_after" | sha256_stream)
    fi
    ;;
esac

if [ "$post_reason" != post_state_verified ]; then
  write_journal partial "$post_reason" || true
  publish_public partial "$post_reason" last || true
  /bin/rm -f "$public_root/active" 2>/dev/null || true
  release_admission || true
  /bin/cat "$claim_directory/journal"
  exit 70
fi

write_journal completed post_state_verified || claim_failure journal_write_failed 74
publish_public completed post_state_verified last || claim_failure public_record_write_failed 74
/bin/rm -f "$public_root/active" || claim_failure public_record_write_failed 74
release_admission || claim_failure admission_release_failed 74
/bin/cat "$claim_directory/journal"
exit 0
