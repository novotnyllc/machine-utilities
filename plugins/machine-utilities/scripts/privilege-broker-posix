exec 8<&-
[[ $apt_architecture =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] &&
  digest "$apt_config_digest" && digest "$effective_config_digest" &&
  digest "$sources_digest" && digest "$keyrings_digest" && digest "$preferences_digest" &&
  digest "$source_identities_digest" && digest "$methods_digest" &&
  digest "$compressors_digest" && digest "$helpers_digest" &&
  digest "$apt_get_digest" && digest "$apt_config_binary_digest" &&
  digest "$apt_cache_digest" && digest "$dpkg_digest" && digest "$dpkg_query_digest" &&
  digest "$dpkg_deb_digest" && digest "$setsid_digest" || reject invalid_apt_context
/usr/bin/awk -v generation="$generation" -v methods="$methods_path" -v dpkg="$dpkg_path" \
    -v architecture="$apt_architecture" '
  BEGIN {
    expected["Dir::Etc::main \"/dev/null\";"]=1
    expected["Dir::Etc::parts \"/dev/null\";"]=1
    expected["Dir::Etc::sourcelist \"" generation "/apt/sources.list\";"]=1
    expected["Dir::Etc::sourceparts \"" generation "/apt/sources.list.d\";"]=1
    expected["Dir::Etc::trusted \"" generation "/apt/trusted.gpg\";"]=1
    expected["Dir::Etc::trustedparts \"" generation "/apt/trusted.gpg.d\";"]=1
    expected["Dir::Etc::preferences \"" generation "/apt/preferences\";"]=1
    expected["Dir::Etc::preferencesparts \"" generation "/apt/preferences.d\";"]=1
    expected["Dir::Bin::methods \"" methods "\";"]=1
    expected["Dir::Bin::dpkg \"" dpkg "\";"]=1
    expected["APT::Architecture \"" architecture "\";"]=1
    expected["Acquire::AllowInsecureRepositories \"false\";"]=1
    expected["APT::Get::AllowUnauthenticated \"false\";"]=1
  }
  $0 !~ /^[ -~]+$/ || !($0 in expected) || seen[$0]++ { exit 1 }
  END { if (NR!=13) exit 1; for (line in expected) if (!seen[line]) exit 1 }
' "$apt_config" || reject apt_configuration_hook_drift
[ "$(sha256_file "$apt_config")" = "$apt_config_digest" ] || reject apt_configuration_drift

for dependency in "$apt_get_path" "$apt_config_path" "$apt_cache_path" "$dpkg_path" \
  "$dpkg_query_path" "$dpkg_deb_path" "$setsid_path"; do
  protected_file "$dependency" 33554432 && [ -x "$dependency" ] || reject apt_dependency_drift
done
[ "$(sha256_file "$apt_get_path")" = "$apt_get_digest" ] &&
  [ "$(sha256_file "$apt_config_path")" = "$apt_config_binary_digest" ] &&
  [ "$(sha256_file "$apt_cache_path")" = "$apt_cache_digest" ] &&
  [ "$(sha256_file "$dpkg_path")" = "$dpkg_digest" ] &&
  [ "$(sha256_file "$dpkg_query_path")" = "$dpkg_query_digest" ] &&
  [ "$(sha256_file "$dpkg_deb_path")" = "$dpkg_deb_digest" ] &&
  [ "$(sha256_file "$setsid_path")" = "$setsid_digest" ] || reject apt_dependency_drift

path_set_digest() {
  listing=$policy_group_tmp/path-set
  : >"$listing" || return 1
  while [ "$#" -gt 0 ]; do
    label=$1
    candidate=$2
    shift 2
    if [ -L "$candidate" ]; then
      return 1
    elif [ -f "$candidate" ]; then
      protected_file "$candidate" 33554432 || return 1
      printf '%s|file|%s\n' "$label" "$(sha256_file "$candidate")" >>"$listing" || return 1
    elif [ -d "$candidate" ]; then
      protected_directory "$candidate" || return 1
      if /usr/bin/find "$candidate" -type l -print | /usr/bin/grep -q .; then return 1; fi
      if /usr/bin/find "$candidate" ! -type d ! -type f -print | /usr/bin/grep -q .; then return 1; fi
      printf '%s|directory\n' "$label" >>"$listing" || return 1
      while IFS= read -r member; do
        protected_file "$member" 33554432 || return 1
        printf '%s/%s|file|%s\n' "$label" "${member#"$candidate"/}" \
          "$(sha256_file "$member")" >>"$listing" || return 1
      done < <(/usr/bin/find "$candidate" -type f -print | /usr/bin/sort)
    elif [ ! -e "$candidate" ]; then
      printf '%s|absent\n' "$label" >>"$listing" || return 1
    else
      return 1
    fi
  done
  sha256_file "$listing"
}

sources_actual=$(path_set_digest source-main "$generation/apt/sources.list" \
  source-parts "$generation/apt/sources.list.d") || reject apt_source_drift
keyrings_actual=$(path_set_digest trusted-main "$generation/apt/trusted.gpg" \
  trusted-parts "$generation/apt/trusted.gpg.d") || reject apt_keyring_drift
preferences_actual=$(path_set_digest preferences-main "$generation/apt/preferences" \
  preferences-parts "$generation/apt/preferences.d") || reject apt_preferences_drift
methods_actual=$(path_set_digest methods "$methods_path") || reject apt_method_drift
compressors_actual=$(path_set_digest gzip "$root_prefix/usr/bin/gzip" xz "$root_prefix/usr/bin/xz" \
  bzip2 "$root_prefix/usr/bin/bzip2" lz4 "$root_prefix/usr/bin/lz4" \
  zstd "$root_prefix/usr/bin/zstd") || reject apt_compressor_drift
helpers_actual=$(path_set_digest apt-helper "$root_prefix/usr/lib/apt/apt-helper" \
  apt-solvers "$root_prefix/usr/lib/apt/solvers" apt-planners "$root_prefix/usr/lib/apt/planners" \
  gpgv "$root_prefix/usr/bin/gpgv") || reject apt_helper_drift
protected_file "$source_identities" 65536 &&
  [ "$(sha256_file "$source_identities")" = "$source_identities_digest" ] || reject apt_source_identity_drift
/usr/bin/awk -F '|' '
  NR==1 { if ($0!="source-identities|1") exit 1; next }
  NF!=3 || $1!="source" || $2!~/^[A-Za-z0-9][A-Za-z0-9._:+@,-]{0,255}$/ ||
    length($3)!=64 || $3!~/^[0-9a-f]+$/ || seen[$2]++ || (previous!=""&&previous>=$0) { exit 1 }
  { previous=$0 }
' "$source_identities" || reject apt_source_identity_drift
[ "$sources_actual" = "$sources_digest" ] && [ "$keyrings_actual" = "$keyrings_digest" ] &&
  [ "$preferences_actual" = "$preferences_digest" ] && [ "$methods_actual" = "$methods_digest" ] &&
  [ "$compressors_actual" = "$compressors_digest" ] && [ "$helpers_actual" = "$helpers_digest" ] ||
  reject apt_source_or_helper_drift

clean_env=(/usr/bin/env -i HOME=/root LC_ALL=C LANG=C TZ=UTC PATH=/usr/sbin:/usr/bin:/sbin:/bin
  DEBIAN_FRONTEND=noninteractive APT_CONFIG="$expected_config")
effective_dump=$policy_group_tmp/apt.dump
"${clean_env[@]}" "$apt_config_path" dump >"$effective_dump" 2>/dev/null ||
  reject apt_effective_configuration_unavailable
[ "$(file_size "$effective_dump")" -le 1048576 ] &&
  [ "$(sha256_file "$effective_dump")" = "$effective_config_digest" ] || reject apt_effective_configuration_drift
! /usr/bin/grep -Eiq '(Pre-Invoke|Post-Invoke|Pre-Install-Pkgs|Proxy::Login|DPkg::Tools::Options|::Command|::Proxy)' \
  "$effective_dump" || reject apt_effective_hook_drift
/usr/bin/awk '
  /::Binary[[:space:]]/ {
    split($0,quoted,"\""); path=quoted[2]
    if (path!="/usr/bin/gzip" && path!="/usr/bin/xz" && path!="/usr/bin/bzip2" &&
        path!="/usr/bin/lz4" && path!="/usr/bin/zstd") exit 1
  }
' "$effective_dump" || reject apt_effective_compressor_drift
observed_architecture=$("${clean_env[@]}" "$dpkg_path" --print-architecture 2>/dev/null) ||
  reject apt_architecture_unavailable
[ "$observed_architecture" = "$apt_architecture" ] || reject apt_architecture_drift

metadata_digest=-
